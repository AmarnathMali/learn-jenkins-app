{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "learnJenkinsApp-TaskDefination-Prod",
    "containerDefinitions": [
        {
            "name": "learnJenkinsApp",
            "image": "909439523426.dkr.ecr.us-east-1.amazonaws.com/myjenkinsapp:1.0.145",
            "portMappings": [{
                "name": "learnjenkinsapp-80-tcp",
                "containerPort": 80,
                "hostPort": 80,
                "protocol": "tcp",
                "appProtocol": "http"
            }],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "512",
    "cpu": "256",
    "executionRoleArn": "arn:aws:iam::909439523426:role/ecsTaskExecutionRole"
}